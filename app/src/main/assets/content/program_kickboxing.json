{
  "sport": "kickboxing",
  "warmup": [
    {"move": "gen_jog", "sets": 1, "sec": 90, "rest": 15},
    {"move": "gen_arm_circles", "sets": 1, "sec": 40, "rest": 15},
    {"move": "gen_jump_rope", "sets": 2, "sec": 90, "rest": 30}
  ],
  "cooldown": [
    {"move": "gen_stretch_hamstring", "sets": 1, "sec": 45, "rest": 10},
    {"move": "gen_stretch_quad", "sets": 1, "sec": 45, "rest": 10},
    {"move": "gen_stretch_shoulder", "sets": 1, "sec": 30, "rest": 10}
  ],
  "phases": [
    {
      "title": "Temeller",
      "weeks": [1, 2],
      "goal": "Duruş, ayak oyunu, jab–cross ve ön tekmeyi (teep) öğrenmek.",
      "sessions": [
        {"code": "A", "title": "Duruş ve Yumruklar", "main": [
          {"move": "kb_stance", "sets": 3, "sec": 45, "rest": 20},
          {"move": "kb_footwork", "sets": 3, "sec": 60, "rest": 30},
          {"move": "kb_jab_cross", "sets": 4, "reps": 15, "rest": 30},
          {"move": "gen_pushup", "sets": 3, "reps": 8, "rest": 45}
        ]},
        {"code": "B", "title": "Teep ve Diz", "main": [
          {"move": "kb_footwork", "sets": 2, "sec": 60, "rest": 30},
          {"move": "kb_teep", "sets": 4, "reps": 10, "rest": 30},
          {"move": "kb_knee", "sets": 3, "reps": 12, "rest": 30},
          {"move": "gen_plank", "sets": 3, "sec": 30, "rest": 30}
        ]},
        {"code": "C", "title": "Gölge ve Kondisyon", "main": [
          {"move": "kb_jab_cross", "sets": 3, "reps": 15, "rest": 30},
          {"move": "kb_teep", "sets": 3, "reps": 10, "rest": 30},
          {"move": "kb_shadow", "sets": 2, "sec": 90, "rest": 60},
          {"move": "gen_squat", "sets": 3, "reps": 15, "rest": 45}
        ]},
        {"code": "D", "title": "Teknik Tekrar", "main": [
          {"move": "kb_stance", "sets": 2, "sec": 45, "rest": 20},
          {"move": "kb_jab_cross", "sets": 3, "reps": 20, "rest": 30},
          {"move": "kb_knee", "sets": 3, "reps": 16, "rest": 30},
          {"move": "gen_situp", "sets": 3, "reps": 15, "rest": 40}
        ]},
        {"code": "E", "title": "Kondisyon", "main": [
          {"move": "gen_jump_rope", "sets": 3, "sec": 120, "rest": 60},
          {"move": "gen_squat", "sets": 3, "reps": 20, "rest": 45},
          {"move": "gen_pushup", "sets": 3, "reps": 10, "rest": 45},
          {"move": "kb_shadow", "sets": 2, "sec": 90, "rest": 60}
        ]}
      ]
    },
    {
      "title": "Yuvarlak Tekmeler ve Savunma",
      "weeks": [3, 4],
      "goal": "Low kick, middle kick ve check (tekme bloğu) tekniklerini öğrenmek.",
      "sessions": [
        {"code": "A", "title": "Low Kick", "main": [
          {"move": "kb_footwork", "sets": 2, "sec": 60, "rest": 30},
          {"move": "kb_low_kick", "sets": 4, "reps": 10, "rest": 40},
          {"move": "kb_combo_jcl", "sets": 3, "reps": 8, "rest": 40},
          {"move": "gen_plank", "sets": 3, "sec": 30, "rest": 30}
        ]},
        {"code": "B", "title": "Middle Kick", "main": [
          {"move": "kb_jab_cross", "sets": 2, "reps": 15, "rest": 30},
          {"move": "kb_middle_kick", "sets": 4, "reps": 8, "rest": 40},
          {"move": "kb_teep", "sets": 3, "reps": 12, "rest": 30},
          {"move": "kb_shadow", "sets": 2, "sec": 120, "rest": 60}
        ]},
        {"code": "C", "title": "Check ve Karşı Atak", "main": [
          {"move": "kb_check", "sets": 4, "reps": 12, "rest": 30},
          {"move": "kb_teep", "sets": 3, "reps": 10, "rest": 30},
          {"move": "kb_knee", "sets": 3, "reps": 16, "rest": 30},
          {"move": "kb_shadow", "sets": 2, "sec": 120, "rest": 60}
        ]},
        {"code": "D", "title": "Kombinasyonlar", "main": [
          {"move": "kb_combo_jcl", "sets": 4, "reps": 10, "rest": 40},
          {"move": "kb_low_kick", "sets": 3, "reps": 10, "rest": 40},
          {"move": "kb_check", "sets": 3, "reps": 12, "rest": 30},
          {"move": "gen_situp", "sets": 3, "reps": 15, "rest": 40}
        ]},
        {"code": "E", "title": "Kondisyon", "main": [
          {"move": "gen_jump_rope", "sets": 3, "sec": 150, "rest": 60},
          {"move": "gen_burpee", "sets": 3, "reps": 8, "rest": 60},
          {"move": "kb_knee", "sets": 3, "reps": 20, "rest": 40},
          {"move": "kb_shadow", "sets": 2, "sec": 120, "rest": 60}
        ]}
      ]
    },
    {
      "title": "Kombinasyon ve Raunt Temposu",
      "weeks": [5, 6],
      "goal": "Yumruk–tekme geçişlerini akıcı hale getirmek, yüksek tekmeye giriş.",
      "sessions": [
        {"code": "A", "title": "Dörtlü Kombinasyon", "main": [
          {"move": "kb_combo_jcl", "sets": 3, "reps": 12, "rest": 30},
          {"move": "kb_combo_jcm", "sets": 4, "reps": 8, "rest": 40},
          {"move": "kb_check", "sets": 3, "reps": 12, "rest": 30},
          {"move": "kb_shadow", "sets": 3, "sec": 150, "rest": 60}
        ]},
        {"code": "B", "title": "High Kick'e Giriş", "main": [
          {"move": "gen_stretch_hamstring", "sets": 2, "sec": 40, "rest": 10},
          {"move": "kb_middle_kick", "sets": 3, "reps": 10, "rest": 40},
          {"move": "kb_high_kick", "sets": 4, "reps": 6, "rest": 45},
          {"move": "kb_shadow", "sets": 2, "sec": 150, "rest": 60}
        ]},
        {"code": "C", "title": "Savunma + Karşı Atak", "main": [
          {"move": "kb_check", "sets": 4, "reps": 12, "rest": 30},
          {"move": "kb_teep", "sets": 3, "reps": 12, "rest": 30},
          {"move": "kb_combo_jcl", "sets": 3, "reps": 10, "rest": 40},
          {"move": "kb_shadow", "sets": 3, "sec": 150, "rest": 60}
        ]},
        {"code": "D", "title": "Raunt Çalışması", "main": [
          {"move": "kb_shadow", "sets": 4, "sec": 180, "rest": 60},
          {"move": "gen_plank", "sets": 3, "sec": 45, "rest": 30}
        ]},
        {"code": "E", "title": "Kondisyon", "main": [
          {"move": "gen_jump_rope", "sets": 4, "sec": 150, "rest": 60},
          {"move": "gen_burpee", "sets": 3, "reps": 10, "rest": 60},
          {"move": "kb_knee", "sets": 3, "reps": 20, "rest": 40},
          {"move": "gen_squat", "sets": 3, "reps": 20, "rest": 45}
        ]}
      ]
    },
    {
      "title": "Pekiştirme ve Değerlendirme",
      "weeks": [7, 8],
      "goal": "Tüm teknikleri tekrar etmek ve 3 dakikalık 4 raunt gölge kick boksla temel seviyeyi göstermek.",
      "sessions": [
        {"code": "A", "title": "Tüm Teknikler", "main": [
          {"move": "kb_jab_cross", "sets": 2, "reps": 20, "rest": 20},
          {"move": "kb_teep", "sets": 2, "reps": 12, "rest": 20},
          {"move": "kb_low_kick", "sets": 2, "reps": 12, "rest": 30},
          {"move": "kb_middle_kick", "sets": 2, "reps": 10, "rest": 30},
          {"move": "kb_knee", "sets": 2, "reps": 16, "rest": 20}
        ]},
        {"code": "B", "title": "Kombinasyon Pekiştirme", "main": [
          {"move": "kb_combo_jcl", "sets": 3, "reps": 12, "rest": 30},
          {"move": "kb_combo_jcm", "sets": 3, "reps": 10, "rest": 40},
          {"move": "kb_high_kick", "sets": 3, "reps": 6, "rest": 45},
          {"move": "kb_shadow", "sets": 3, "sec": 180, "rest": 60}
        ]},
        {"code": "C", "title": "Değerlendirme: 4 Raunt", "main": [
          {"move": "kb_shadow", "sets": 4, "sec": 180, "rest": 60},
          {"move": "gen_pushup", "sets": 2, "reps": 15, "rest": 45}
        ]},
        {"code": "D", "title": "Savunma Pekiştirme", "main": [
          {"move": "kb_check", "sets": 3, "reps": 16, "rest": 30},
          {"move": "kb_footwork", "sets": 2, "sec": 90, "rest": 30},
          {"move": "kb_combo_jcl", "sets": 3, "reps": 12, "rest": 30},
          {"move": "kb_shadow", "sets": 3, "sec": 180, "rest": 60}
        ]},
        {"code": "E", "title": "Kondisyon", "main": [
          {"move": "gen_jump_rope", "sets": 4, "sec": 180, "rest": 60},
          {"move": "gen_burpee", "sets": 3, "reps": 12, "rest": 60},
          {"move": "gen_situp", "sets": 3, "reps": 20, "rest": 40},
          {"move": "gen_plank", "sets": 3, "sec": 60, "rest": 30}
        ]}
      ]
    }
  ]
}
